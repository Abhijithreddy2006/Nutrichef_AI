# =====================================================================
# FRIDGE-TO-RECIPE APP: FREE API KEY SETUP GUIDE
# =====================================================================
# Choose ONE of the free providers below and paste your key into `.env.local`:

# OPTION 1: GROQ API (RECOMMENDED - Super Fast & Free)
# 1. Sign up/in at https://console.groq.com/keys
# 2. Click "Create API Key"
# 3. Paste key below:
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# OPTION 2: OPENROUTER API (Instant Free Access)
# 1. Sign up at https://openrouter.ai/keys
# 2. Click "Create Key"
# 3. Paste key below:
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# OPTIONAL FALLBACKS:
# GEMINI_API_KEY=your_gemini_api_key_here
# VITE_OPENAI_API_KEY=your_openai_api_key_here
